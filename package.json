{
  "name": "chelie-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.restore.config.ts",
    "build": "tsc && vite build --config vite.restore.config.ts",
    "preview": "vite preview --config vite.restore.config.ts",
    "cap:sync": "npm run build && cap sync android",
    "android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
